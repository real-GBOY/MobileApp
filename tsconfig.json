{
   "extends": "expo/tsconfig.base",
   "compilerOptions": {
      "strict": true,
      "baseUrl": ".",
      "ignoreDeprecations": "6.0",
      "paths": {
         "@/*": ["./src/*", "./app/*", "./assets/*"]
      }
   },
   "include": [
      "**/*.ts",
      "**/*.tsx",
      ".expo/types/**/*.ts",
      "expo-env.d.ts",
      "nativewind-env.d.ts",
      "global.d.ts"
   ]
}
